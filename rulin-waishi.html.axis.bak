<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="《儒林外史》人物志：吴敬梓笔下士林群像，白描勾勒，冷隽讽刺。收录二十位人物小传、关系图谱、游历地图与情节时间线。">
<title>儒林外史 · 人物志 — zzht</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700;900&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
:root {
  --paper: #f5ecd6;
  --paper-deep: #ede1c0;
  --paper-light: #fbf5e2;
  --paper-warm: #f0e4c8;
  --ink: #2b2620;
  --ink-soft: #5c5346;
  --ink-faint: #8c836f;
  --red: #a8281c;
  --red-bright: #c4341e;
  --red-soft: #b8493a;
  --jade: #5b7a78;
  --jade-light: #7a9a98;
  --brown: #8c7a5e;
  --brown-light: #a89878;
  --border: #d9c89e;
  --border-soft: #e4d8b8;
  --shadow: rgba(90, 70, 30, 0.08);
  --serif: 'Noto Serif SC', 'STSong', 'SimSun', serif;
  --sans: 'Noto Sans SC', -apple-system, BlinkMacSystemFont, sans-serif;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--sans);
  color: var(--ink);
  line-height: 1.8;
  overflow-x: hidden;
  /* 泛黄书页底色 + 极淡竖向版心栏线 */
  background-color: var(--paper);
  background-image:
    repeating-linear-gradient(90deg,
      transparent 0px, transparent 119px,
      rgba(140,122,94,0.06) 119px, rgba(140,122,94,0.06) 120px,
      transparent 120px, transparent 240px,
      rgba(140,122,94,0.10) 240px, rgba(140,122,94,0.10) 241px),
    linear-gradient(180deg, rgba(237,225,192,0.4) 0%, rgba(245,236,214,0) 400px);
}
::selection { background: rgba(168,40,28,0.15); }

/* 顶部朱栏 */
.top-red-bar {
  height: 4px;
  background: var(--red);
  position: relative;
  z-index: 50;
}
.top-red-bar::after {
  content: '';
  position: absolute; left: 0; right: 0; bottom: -2px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--red), transparent);
  opacity: 0.4;
}

/* back home */
.back-home {
  position: fixed; top: 16px; left: 20px; z-index: 120;
  font-size: 0.82rem; color: var(--ink-soft); text-decoration: none;
  padding: 6px 14px; border-radius: 999px;
  background: rgba(245,236,214,0.9);
  border: 1px solid var(--border);
  transition: all 0.25s;
  letter-spacing: 0.05em;
}
.back-home:hover { color: var(--red); border-color: var(--red); transform: translateX(-2px); }

/* ===== HERO：线装书封面 ===== */
.hero {
  position: relative;
  padding: 60px 24px 50px;
  overflow: hidden;
  background:
    radial-gradient(ellipse 70% 50% at 50% 0%, rgba(168,40,28,0.06), transparent 60%),
    linear-gradient(180deg, var(--paper-warm) 0%, var(--paper) 70%);
}
.hero-inner {
  max-width: 1100px; margin: 0 auto;
  display: flex; align-items: flex-start; gap: 60px;
  flex-wrap: wrap;
}
.hero-text { flex: 1; min-width: 280px; }
.hero-eyebrow {
  font-size: 0.82rem; letter-spacing: 0.3em; color: var(--brown);
  margin-bottom: 18px; font-weight: 400;
}
.hero h1 {
  font-family: var(--serif); font-size: clamp(2.4rem, 6vw, 3.8rem);
  font-weight: 900; letter-spacing: 0.12em; color: var(--ink);
  line-height: 1.15;
}
.hero h1 .sep { color: var(--red); opacity: 0.5; margin: 0 0.15em; font-weight: 400; }
.hero-sub {
  margin-top: 14px; color: var(--ink-soft); font-size: 0.92rem;
  letter-spacing: 0.2em; font-weight: 300;
}
/* 乌纱帽分隔 */
.hero-divider {
  display: flex; align-items: center; gap: 14px;
  margin: 26px 0 22px;
}
.hero-divider::before, .hero-divider::after {
  content: ''; height: 1px; flex: 0 0 80px;
}
.hero-divider::before { background: linear-gradient(90deg, transparent, var(--red)); }
.hero-divider::after { background: linear-gradient(270deg, transparent, var(--red)); }
.hero-tagline {
  font-family: var(--serif); font-size: 1rem; color: var(--ink-soft);
  line-height: 2.1; max-width: 480px;
}
.hero-tagline .em { color: var(--red); font-weight: 600; }
.hero-stats {
  display: flex; flex-wrap: wrap; gap: 8px 40px;
  margin-top: 32px;
}
.hero-stat { text-align: left; }
.hero-stat .val {
  display: block; font-family: var(--serif); font-weight: 900;
  font-size: 1.5rem; color: var(--red); line-height: 1.2;
}
.hero-stat .lbl { font-size: 0.76rem; color: var(--ink-faint); letter-spacing: 0.1em; margin-top: 2px; }

/* 竖标题 + 朱砂方印 */
.hero-title-block {
  display: flex; align-items: flex-start; gap: 20px;
  padding: 10px 20px 10px 40px;
  border-right: 1px solid var(--border);
}
.hero-vtitle {
  writing-mode: vertical-rl;
  font-family: var(--serif);
  font-size: clamp(3rem, 7vw, 4.5rem);
  font-weight: 900; letter-spacing: 0.22em;
  color: var(--ink); line-height: 1.05;
}
.hero-seal {
  display: flex; flex-direction: column; gap: 8px;
  margin-top: 10px;
}
.seal-stamp {
  display: inline-flex; flex-direction: column;
  align-items: center; justify-content: center;
  background: var(--red); color: var(--paper-light);
  font-family: var(--serif); font-weight: 900;
  font-size: 0.82rem; padding: 8px 11px;
  border-radius: 3px;
  transform: rotate(-3deg);
  letter-spacing: 0.12em; line-height: 1.35;
  box-shadow: 0 0 0 2px var(--red), 0 0 0 4px var(--paper), 0 3px 10px rgba(168,40,28,0.25);
}
.seal-stamp span { display: block; }

/* ===== NAV ===== */
.nav-bar {
  position: sticky; top: 0; z-index: 100;
  background: rgba(245,236,214,0.98);
  border-bottom: 1px solid var(--border);
}
.nav-inner {
  max-width: 1100px; margin: 0 auto;
  display: flex; overflow-x: auto; scrollbar-width: none;
  padding: 0 16px;
}
.nav-inner::-webkit-scrollbar { display: none; }
.nav-tab {
  flex: 0 0 auto; padding: 14px 20px; cursor: pointer;
  font-size: 0.9rem; color: var(--ink-soft); letter-spacing: 0.08em;
  position: relative; transition: color 0.25s; white-space: nowrap;
  user-select: none; background: none; border: none;
  font-family: var(--sans);
}
.nav-tab::after {
  content: ''; position: absolute; left: 20px; right: 20px; bottom: 0;
  height: 2px; border-radius: 2px;
  background: linear-gradient(90deg, var(--red), var(--brown));
  transform: scaleX(0); transition: transform 0.3s;
}
.nav-tab:hover { color: var(--ink); }
.nav-tab.active { color: var(--red); font-weight: 600; }
.nav-tab.active::after { transform: scaleX(1); }

/* ===== MAIN ===== */
.main-container {
  max-width: 1100px; margin: 0 auto;
  padding: 40px 24px 60px;
}
.section { display: none; }
.section.active { display: block; }

/* section title */
.sec-title {
  font-family: var(--serif); font-size: clamp(1.5rem, 3.5vw, 2rem);
  font-weight: 900; letter-spacing: 0.1em; color: var(--ink);
  display: flex; align-items: baseline; gap: 14px;
  flex-wrap: wrap;
}
.sec-title::after {
  content: ''; flex: 1; height: 1px;
  background: linear-gradient(90deg, var(--border), transparent);
  min-width: 60px;
}
.sec-title .sub {
  font-size: 0.78rem; color: var(--ink-faint);
  font-weight: 400; letter-spacing: 0.12em;
}
.sec-desc {
  margin-top: 14px; color: var(--ink-soft); max-width: 760px;
  font-size: 0.92rem; line-height: 2;
}

/* 乌纱帽小分隔 */
.hat-sep {
  display: flex; align-items: center; justify-content: center;
  gap: 16px; margin: 36px 0;
}
.hat-sep::before, .hat-sep::after {
  content: ''; height: 1px; flex: 1; max-width: 200px;
}
.hat-sep::before { background: linear-gradient(90deg, transparent, var(--border)); }
.hat-sep::after { background: linear-gradient(270deg, transparent, var(--border)); }

/* ===== OVERVIEW ===== */
.ov-intro {
  background: var(--paper-light);
  border: 1px solid var(--border-soft); border-radius: 20px;
  padding: 32px 34px; margin-top: 28px;
  box-shadow: 0 8px 20px var(--shadow);
  position: relative;
}
.ov-intro::before {
  content: ''; position: absolute; top: 0; left: 34px; right: 34px; height: 3px;
  background: linear-gradient(90deg, var(--red), transparent 60%);
  border-radius: 0 0 4px 4px;
}
.ov-intro h2 {
  font-family: var(--serif); font-size: 1.25rem; font-weight: 700;
  color: var(--red); margin-bottom: 14px; letter-spacing: 0.06em;
}
.ov-intro p {
  font-size: 0.92rem; color: var(--ink-soft); line-height: 2.1;
  margin-bottom: 12px;
}
.ov-intro p b { color: var(--ink); font-weight: 600; }
.ov-intro .lede {
  font-family: var(--serif); font-size: 1.05rem; color: var(--ink);
  line-height: 2.1;
}
.ov-intro .lede::first-letter {
  font-size: 2.4em; float: left; line-height: 1; padding-right: 0.1em;
  color: var(--red); font-weight: 900;
}
.ov-cats-title {
  font-family: var(--serif); font-size: 1.05rem; color: var(--ink);
  margin: 32px 0 16px; letter-spacing: 0.06em;
}
.cat-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 14px;
}
.cat-card {
  background: var(--paper-light); border: 1px solid var(--border-soft);
  border-radius: 18px; padding: 20px 18px;
  cursor: pointer; transition: all 0.25s;
  position: relative; overflow: hidden;
}
.cat-card::before {
  content: ''; position: absolute; top: 0; left: 18px; right: 18px; height: 2px;
  background: var(--gc, var(--red)); opacity: 0.7; border-radius: 0 0 3px 3px;
}
.cat-card:hover {
  transform: translateY(-3px); box-shadow: 0 8px 20px var(--shadow);
  border-color: var(--gc, var(--red));
}
.cat-card .cat-head {
  display: flex; align-items: center; gap: 10px; margin-bottom: 8px;
}
.cat-card .cat-icon {
  width: 36px; height: 36px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem; color: var(--paper-light);
  background: var(--gc, var(--red));
  flex-shrink: 0;
}
.cat-card .cat-name {
  font-family: var(--serif); font-size: 1.02rem; font-weight: 700;
  color: var(--ink); letter-spacing: 0.03em;
}
.cat-card .cat-count {
  font-size: 0.78rem; color: var(--ink-faint); margin-top: 2px;
}
.cat-card .cat-desc {
  font-size: 0.82rem; color: var(--ink-soft); line-height: 1.7; margin-top: 6px;
}

/* ===== CHARACTERS：科举金榜 ===== */
.toolbar {
  display: flex; gap: 12px; margin: 28px 0 24px;
  flex-wrap: wrap; align-items: center;
}
.search-box {
  flex: 1; min-width: 220px; position: relative;
}
.search-box input {
  width: 100%; padding: 11px 16px 11px 42px;
  border: 1.5px solid var(--border); border-radius: 999px;
  font-size: 0.9rem; font-family: var(--sans);
  background: var(--paper-light); color: var(--ink);
  transition: border-color 0.25s; outline: none;
}
.search-box input:focus { border-color: var(--red); }
.search-box input::placeholder { color: var(--ink-faint); }
.search-box .sb-icon {
  position: absolute; left: 16px; top: 50%; transform: translateY(-50%);
  width: 16px; height: 16px; opacity: 0.4;
}
.filter-chips {
  display: flex; gap: 8px; flex-wrap: wrap;
}
.chip {
  padding: 7px 16px; border: 1.5px solid var(--border);
  border-radius: 999px; background: var(--paper-light);
  cursor: pointer; font-size: 0.82rem; color: var(--ink-soft);
  transition: all 0.25s; font-family: var(--sans);
  letter-spacing: 0.03em;
}
.chip:hover { border-color: var(--red); color: var(--red); transform: translateY(-1px); }
.chip.active {
  background: var(--red); color: var(--paper-light); border-color: var(--red);
  font-weight: 500;
}

/* 人物卡片卷轴容器 */
.scroll-wrap {
  position: relative; margin-top: 8px;
}
.scroll-wrap::before, .scroll-wrap::after {
  content: ''; position: absolute; top: 0; bottom: 0; width: 12px;
  background: linear-gradient(90deg, var(--paper-deep), transparent);
  z-index: 1; pointer-events: none;
}
.scroll-wrap::before { left: 0; }
.scroll-wrap::after { right: 0; background: linear-gradient(270deg, var(--paper-deep), transparent); }

.cards-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  gap: 18px;
  counter-reset: rank;
}
.char-card {
  background: var(--paper-light);
  border: 1px solid var(--border-soft); border-radius: 20px;
  padding: 22px 22px 18px; cursor: pointer;
  position: relative; overflow: hidden;
  counter-increment: rank;
  transition: transform 0.3s cubic-bezier(0.34,1.4,0.5,1), box-shadow 0.3s, border-color 0.3s;
}
.char-card::before {
  content: ''; position: absolute; top: 0; left: 22px; right: 22px; height: 3px;
  border-radius: 0 0 4px 4px;
  background: linear-gradient(90deg, var(--gc, var(--red)), transparent 70%);
  opacity: 0.8;
}
.char-card::after {
  content: '第 ' counter(rank, cjk-ideographic) ' 位';
  position: absolute; top: 13px; right: 18px;
  font-family: var(--serif); font-size: 0.74rem;
  color: rgba(168,40,28,0.35); letter-spacing: 0.05em;
}
.char-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px var(--shadow);
  border-color: var(--gc, var(--red));
}
.char-card .c-head {
  display: flex; align-items: center; gap: 12px; margin-bottom: 12px;
}
/* 朱笔圈点人名 */
.c-name-stamped {
  position: relative; display: inline-block;
  font-family: var(--serif); font-size: 1.15rem; font-weight: 700;
  color: var(--ink); padding: 2px 4px; letter-spacing: 0.03em;
}
.c-name-stamped::after {
  content: ''; position: absolute;
  left: -3px; top: 50%; transform: translateY(-50%);
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--red); opacity: 0.85;
}
.c-alias {
  font-size: 0.78rem; color: var(--ink-faint); margin-top: 3px;
}
.c-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
.c-tag {
  font-size: 0.72rem; padding: 3px 10px; border-radius: 999px;
  letter-spacing: 0.03em;
}
.c-tag-cat {
  color: var(--gc, var(--red));
  background: color-mix(in srgb, var(--gc, var(--red)) 8%, var(--paper-light));
  border: 1px solid color-mix(in srgb, var(--gc, var(--red)) 22%, var(--paper-light));
}
.c-tag-chap {
  color: var(--jade); background: rgba(91,122,120,0.08);
  border: 1px solid rgba(91,122,120,0.2);
}
.c-desc {
  font-size: 0.84rem; color: var(--ink-soft); line-height: 1.75;
  display: -webkit-box; -webkit-line-clamp: 3;
  -webkit-box-orient: vertical; overflow: hidden;
}
.c-foot {
  margin-top: 12px; padding-top: 10px;
  border-top: 1px dashed var(--border);
  display: flex; justify-content: space-between; align-items: center;
  font-size: 0.78rem; color: var(--ink-faint);
}
.c-foot .c-scene {
  font-family: var(--serif); color: var(--red); opacity: 0.7;
  max-width: 65%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-size: 0.76rem;
}

/* no results */
.no-results {
  text-align: center; padding: 60px 20px;
  color: var(--ink-faint); font-size: 1rem;
}
.no-results .nr-icon {
  font-family: var(--serif); font-size: 2.4rem; color: var(--border);
  margin-bottom: 12px;
}

/* ===== MODAL：人物档案 ===== */
.modal-overlay {
  display: none; position: fixed; inset: 0; z-index: 200;
  background: rgba(43,38,32,0.45);
  justify-content: center; align-items: flex-start;
  padding: 40px 20px; overflow-y: auto;
  opacity: 0; transition: opacity 0.3s;
}
.modal-overlay.show { display: flex; opacity: 1; }
.modal {
  background: var(--paper-light); border-radius: 22px;
  max-width: 680px; width: 100%; position: relative;
  overflow: hidden;
  border-top: 4px solid var(--red);
  box-shadow: 0 20px 50px rgba(43,38,32,0.2);
  transform: translateY(16px); transition: transform 0.3s;
}
.modal-overlay.show .modal { transform: translateY(0); }
.modal-close {
  position: absolute; top: 14px; right: 18px; z-index: 10;
  width: 34px; height: 34px; border-radius: 50%;
  border: none; background: rgba(245,236,214,0.9);
  font-size: 1.2rem; cursor: pointer; color: var(--ink-soft);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.2s;
}
.modal-close:hover { background: var(--red); color: var(--paper-light); }
.modal-banner {
  padding: 28px 36px 20px;
  background:
    linear-gradient(180deg, var(--paper-warm) 0%, var(--paper-light) 100%);
  border-bottom: 1px solid var(--border-soft);
  position: relative;
}
.modal-banner::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: var(--gc, var(--red));
}
.modal-banner h2 {
  font-family: var(--serif); font-size: 1.7rem; font-weight: 900;
  color: var(--ink); display: flex; align-items: center; gap: 8px;
}
.modal-banner h2 .mb-seal {
  display: inline-block; background: var(--red); color: var(--paper-light);
  font-size: 0.6em; font-weight: 900; padding: 3px 8px;
  border-radius: 3px; transform: rotate(-3deg);
  letter-spacing: 0.1em; vertical-align: middle;
}
.modal-banner .mb-sub {
  color: var(--ink-faint); font-size: 0.86rem; margin-top: 6px;
  font-family: var(--serif);
}
.modal-banner .mb-tags {
  display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap;
}
.modal-body { padding: 26px 36px 34px; }
.modal-section { margin-bottom: 22px; }
.modal-section h3 {
  font-family: var(--serif); font-size: 0.96rem; font-weight: 700;
  color: var(--red); margin-bottom: 10px; letter-spacing: 0.06em;
  display: flex; align-items: center; gap: 8px;
}
.modal-section h3::before {
  content: ''; width: 3px; height: 14px; border-radius: 2px;
  background: var(--red);
}
.modal-section p, .modal-section ul {
  font-size: 0.9rem; color: var(--ink-soft); line-height: 2;
}
.modal-section ul { padding-left: 1.2em; }
.modal-section li { margin-bottom: 4px; }
.info-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
}
.info-item {
  background: var(--paper); border: 1px solid var(--border-soft);
  padding: 12px 14px; border-radius: 14px;
}
.info-item .info-label {
  font-size: 0.74rem; color: var(--ink-faint); margin-bottom: 4px;
  letter-spacing: 0.05em;
}
.info-item .info-value {
  font-size: 0.88rem; font-weight: 500; color: var(--ink);
}
.quote-block {
  background: rgba(168,40,28,0.05);
  border-left: 3px solid var(--red);
  padding: 14px 18px; border-radius: 0 14px 14px 0;
  font-family: var(--serif); font-size: 0.95rem; color: var(--ink);
  line-height: 1.9; position: relative;
}
.quote-block::before {
  content: '朱批'; position: absolute; top: 8px; right: 14px;
  font-size: 0.68rem; color: var(--red); opacity: 0.4;
  letter-spacing: 0.1em; font-weight: 600;
}
.relation-list {
  display: flex; flex-wrap: wrap; gap: 8px;
}
.relation-tag {
  padding: 6px 14px; background: var(--paper);
  border: 1px solid var(--border); border-radius: 999px;
  font-size: 0.82rem; cursor: pointer; transition: all 0.25s;
  color: var(--ink-soft);
}
.relation-tag:hover {
  background: var(--red); color: var(--paper-light); border-color: var(--red);
}
.relation-tag small {
  color: var(--ink-faint); margin-left: 4px; font-size: 0.78em;
}
.relation-tag:hover small { color: rgba(251,245,226,0.7); }

/* ===== RELATIONS：关系图谱 ===== */
.graph-wrap {
  margin-top: 28px; background: var(--paper-light);
  border: 1px solid var(--border-soft); border-radius: 24px;
  padding: 24px; position: relative;
  box-shadow: 0 8px 20px var(--shadow);
}
.graph-toolbar {
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 10px; margin-bottom: 16px;
}
.graph-toolbar .gt-title {
  font-family: var(--serif); font-size: 1.05rem; font-weight: 700;
  color: var(--ink); letter-spacing: 0.04em;
}
.graph-legend {
  display: flex; gap: 14px; flex-wrap: wrap;
}
.lg-item {
  display: flex; align-items: center; gap: 6px;
  font-size: 0.78rem; color: var(--ink-soft);
}
.lg-dot {
  width: 10px; height: 10px; border-radius: 50%;
}
.lg-dash {
  width: 18px; height: 2px; border-radius: 2px;
  background: repeating-linear-gradient(90deg, var(--ink-faint) 0 4px, transparent 4px 7px);
}
#relationMap { width: 100%; overflow: auto; }
#relationMap svg { display: block; margin: 0 auto; }
.map-node { cursor: pointer; }
.map-node circle { transition: all 0.2s; }
.map-node:hover .node-halo { opacity: 0.25 !important; }

/* ===== TIMELINE：卷轴展开 ===== */
.tl-era {
  text-align: center; font-family: var(--serif);
  font-size: 1rem; color: var(--red); font-weight: 700;
  letter-spacing: 0.15em; margin-bottom: 36px;
  padding: 14px 20px; border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  background: var(--paper-light);
  border-radius: 20px;
}
.tl-era small {
  display: block; font-size: 0.74rem; color: var(--ink-faint);
  font-weight: 400; margin-top: 4px; letter-spacing: 0;
  font-family: var(--sans);
}
.tl-container {
  position: relative; max-width: 900px; margin: 0 auto;
  padding: 0 0 0 0;
}
.tl-container::before {
  content: ''; position: absolute; left: 28px; top: 0; bottom: 0;
  width: 2px;
  background: linear-gradient(180deg, transparent 0%, var(--border) 4%, var(--border) 96%, transparent 100%);
}
.tl-item {
  position: relative; margin-left: 60px; margin-bottom: 24px;
  padding: 18px 22px;
  background: var(--paper-light); border: 1px solid var(--border-soft);
  border-radius: 18px;
  transition: all 0.3s;
}
.tl-item:hover {
  box-shadow: 0 8px 24px var(--shadow);
  border-color: var(--red);
  transform: translateX(4px);
}
.tl-dot {
  position: absolute; left: -38px; top: 24px;
  width: 14px; height: 14px; border-radius: 50%;
  background: var(--paper); border: 2.5px solid var(--red);
  z-index: 2; transition: all 0.3s;
}
.tl-item:hover .tl-dot { background: var(--red); transform: scale(1.15); }
.tl-year {
  display: inline-block; font-family: var(--serif);
  font-size: 0.76rem; font-weight: 700; color: var(--red);
  background: rgba(168,40,28,0.06);
  padding: 3px 12px; border-radius: 999px;
  margin-bottom: 8px; letter-spacing: 0.03em;
}
.tl-chapter {
  font-family: var(--serif); font-size: 0.78rem; color: var(--brown);
  font-weight: 600; margin-bottom: 4px; letter-spacing: 0.03em;
}
.tl-title {
  font-family: var(--serif); font-size: 1.1rem; font-weight: 700;
  color: var(--ink); margin-bottom: 8px;
}
.tl-chars {
  display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 8px;
}
.tl-char-tag {
  padding: 3px 10px; background: rgba(168,40,28,0.06);
  color: var(--red); border-radius: 999px;
  font-size: 0.76rem; cursor: pointer; transition: all 0.25s;
  border: 1px solid rgba(168,40,28,0.15);
}
.tl-char-tag:hover { background: var(--red); color: var(--paper-light); }
.tl-desc {
  font-size: 0.86rem; color: var(--ink-soft); line-height: 1.85;
}

/* ===== TRAVEL MAP：江南水乡 ===== */
.travel-wrap {
  background: var(--paper-light); border: 1px solid var(--border-soft);
  border-radius: 24px; overflow: hidden;
  box-shadow: 0 8px 20px var(--shadow);
  margin-top: 28px;
}
.travel-header {
  padding: 20px 28px; border-bottom: 1px solid var(--border-soft);
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 10px;
}
.travel-header h3 {
  font-family: var(--serif); font-size: 1.15rem; font-weight: 700;
  color: var(--ink); letter-spacing: 0.04em;
}
.travel-header .th-hint {
  font-size: 0.8rem; color: var(--ink-faint);
}
.travel-content {
  display: flex; min-height: 400px;
}
.map-svg-container {
  flex: 1; padding: 16px; min-width: 0;
  background:
    repeating-linear-gradient(90deg,
      transparent 0px, transparent 79px,
      rgba(91,122,120,0.04) 79px, rgba(91,122,120,0.04) 80px),
    var(--paper-warm);
}
.map-svg-container svg { width: 100%; height: auto; }
.route-sidebar {
  width: 260px; padding: 22px;
  border-left: 1px solid var(--border-soft);
  flex-shrink: 0; background: var(--paper-light);
}
.route-sidebar h4 {
  font-family: var(--serif); font-size: 0.98rem; font-weight: 700;
  margin-bottom: 14px; color: var(--ink); letter-spacing: 0.04em;
}
.route-btn {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 12px 14px; margin-bottom: 8px;
  border: 1.5px solid var(--border-soft); border-radius: 14px;
  background: var(--paper); cursor: pointer;
  transition: all 0.25s; width: 100%; text-align: left;
  font-family: var(--sans);
}
.route-btn:hover {
  border-color: var(--jade); box-shadow: 0 2px 8px var(--shadow);
}
.route-btn.active {
  border-color: var(--red); background: rgba(168,40,28,0.04);
}
.route-color {
  width: 4px; min-height: 32px; border-radius: 2px;
  flex-shrink: 0; margin-top: 2px;
}
.route-info { flex: 1; }
.route-name {
  font-weight: 600; font-size: 0.9rem; color: var(--ink);
  display: block; margin-bottom: 2px;
  font-family: var(--serif);
}
.route-path {
  font-size: 0.78rem; color: var(--ink-faint); line-height: 1.5;
}
.route-note {
  margin-top: 14px; padding-top: 12px;
  border-top: 1px dashed var(--border);
  font-size: 0.8rem; color: var(--ink-faint); line-height: 1.75;
}
.route-note strong { color: var(--ink); }
.map-legend-bar {
  padding: 12px 24px; border-top: 1px solid var(--border-soft);
  display: flex; gap: 16px; flex-wrap: wrap;
  font-size: 0.8rem; color: var(--ink-soft);
  background: var(--paper);
}
.map-legend-bar .leg-item {
  display: flex; align-items: center; gap: 6px;
}
.map-legend-bar .leg-dot {
  width: 10px; height: 10px; border-radius: 50%;
}
@keyframes routeDashFlow { to { stroke-dashoffset: -24; } }

/* ===== FOOTER ===== */
.site-footer {
  max-width: 1100px; margin: 60px auto 0;
  padding: 26px 24px 40px;
  border-top: 1px solid var(--border);
  font-size: 0.82rem; color: var(--ink-faint);
  display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;
}
.site-footer a { color: var(--ink-soft); text-decoration: none; transition: color 0.2s; }
.site-footer a:hover { color: var(--red); }
.foot-mark { display: inline-flex; align-items: center; gap: 8px; }

/* ===== RESPONSIVE ===== */
@media (max-width: 820px) {
  .hero-inner { gap: 30px; }
  .hero-title-block {
    border-right: none; border-bottom: 1px solid var(--border);
    padding: 0 0 20px 0;
  }
  .hero-vtitle { font-size: 3.2rem; }
  .travel-content { flex-direction: column; }
  .route-sidebar { width: 100%; border-left: none; border-top: 1px solid var(--border-soft); }
  .info-grid { grid-template-columns: 1fr; }
  .modal-body { padding: 20px 22px 26px; }
  .modal-banner { padding: 22px 24px 16px; }
}
@media (max-width: 520px) {
  .hero { padding: 40px 16px 36px; }
  .hero h1 { font-size: 2rem; }
  .hero-vtitle { font-size: 2.6rem; }
  .main-container { padding: 28px 14px 40px; }
  .nav-tab { padding: 12px 14px; font-size: 0.84rem; }
  .cards-grid { grid-template-columns: 1fr; }
  .ov-intro { padding: 22px 20px; }
  .tl-item { margin-left: 48px; padding: 14px 16px; }
  .tl-dot { left: -34px; }
  .hero-stats { gap: 8px 24px; }
  .hero-stat .val { font-size: 1.3rem; }
}
</style>
</head>
<body>

<div class="top-red-bar"></div>
<a href="/" class="back-home">← 返回首页</a>

<!-- ===== HERO ===== -->
<header class="hero">
  <div class="hero-inner">
    <div class="hero-title-block">
      <div class="hero-vtitle">儒林外史</div>
      <div class="hero-seal">
        <div class="seal-stamp"><span>儒林</span><span>外史</span></div>
        <div class="seal-stamp" style="transform:rotate(2deg); background:var(--ink); box-shadow:0 0 0 2px var(--ink), 0 0 0 4px var(--paper), 0 3px 10px rgba(43,38,32,0.2);"><span>吴敬梓</span></div>
      </div>
    </div>
    <div class="hero-text">
      <div class="hero-eyebrow">吴敬梓 著 · 清代讽刺小说 · 乾隆十四年成书</div>
      <h1>儒<span class="sep">·</span>林<span class="sep">·</span>外<span class="sep">·</span>史</h1>
      
      <div class="hero-divider">
        <svg viewBox="0 0 80 36" width="56" height="26" aria-hidden="true">
          <path d="M16 30 Q16 18 26 14 L54 14 Q64 18 64 30 Z" fill="#2b2620"/>
          <ellipse cx="40" cy="14" rx="14" ry="5" fill="#2b2620"/>
          <line x1="2" y1="22" x2="16" y2="22" stroke="#2b2620" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="64" y1="22" x2="78" y2="22" stroke="#2b2620" stroke-width="2.5" stroke-linecap="round"/>
          <rect x="1" y="20" width="3" height="5" fill="#2b2620" rx="1"/>
          <rect x="76" y="20" width="3" height="5" fill="#2b2620" rx="1"/>
          <circle cx="40" cy="9" r="2.5" fill="#a8281c"/>
        </svg>
      </div>
      <p class="hero-tagline">白描勾勒士林群像，<span class="em">冷隽讽刺</span>笑中带酸。全书五十六回，描绘明清士人科举浮沉、功名冷暖——从王冕高洁开篇，到市井奇人收束。</p>
      <div class="hero-stats">
        <div class="hero-stat"><span class="val" id="totalChars">0</span><span class="lbl">收录人物</span></div>
        <div class="hero-stat"><span class="val">56</span><span class="lbl">全书回目</span></div>
        <div class="hero-stat"><span class="val" id="totalCats">0</span><span class="lbl">人物分类</span></div>
        <div class="hero-stat"><span class="val" id="totalEvents">0</span><span class="lbl">经典事件</span></div>
      </div>
    </div>
  </div>
</header>

<!-- ===== NAV ===== -->
<nav class="nav-bar">
  <div class="nav-inner">
    <button class="nav-tab active" data-section="overview">概览</button>
    <button class="nav-tab" data-section="characters">人物图鉴</button>
    <button class="nav-tab" data-section="relations">关系图谱</button>
    <button class="nav-tab" data-section="travelmap">游历地图</button>
    <button class="nav-tab" data-section="timeline">情节时间线</button>
  </div>
</nav>

<!-- ===== MAIN ===== -->
<div class="main-container">

  <!-- ====== OVERVIEW ====== -->
  <section id="overview" class="section active">
    <h2 class="sec-title">关于本书 <span class="sub">儒林百态 · 讽刺之书</span></h2>
    <div class="ov-intro">
      <h2>白描士林，冷隽讽刺</h2>
      <p class="lede">《儒林外史》是清代吴敬梓所著的长篇讽刺小说，全书共五十六回，成书于乾隆十四年（1749年）。作品以封建社会知识分子为主要描写对象，通过描绘士林群像，深刻揭露了科举制度对读书人灵魂的腐蚀与毒害。</p>
      <p>全书没有贯穿始终的中心人物和核心事件，而是以<b>"连环套"式的结构</b>，一个个人物故事前后衔接，展现了一幅封建社会士人阶层的生活画卷。从王冕的高洁隐逸开篇，到市井奇人的收束，吴敬梓以冷峻犀利的笔触，刻画了形形色色的读书人——有痴迷功名者，有慷慨豪侠者，有迂腐可笑者，也有洁身自好者。</p>
    </div>
    <h3 class="ov-cats-title">人物分类</h3>
    <div class="cat-grid" id="categoryCards"></div>
  </section>

  <!-- ====== CHARACTERS ====== -->
  <section id="characters" class="section">
    <h2 class="sec-title">人物图鉴 <span class="sub">儒林谱 · 朱笔圈点</span></h2>
    <p class="sec-desc">二十位人物，按类分卷。点击卡片查看小传、性格、经典情节与人物关系。朱笔圈点处为诸公名讳，乌纱帽下尽是酸楚。</p>
    <div class="toolbar">
      <div class="search-box">
        <svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="text" id="searchInput" placeholder="搜索人物姓名、字号、身份...">
      </div>
      <div class="filter-chips" id="filterChips"></div>
    </div>
    <div class="scroll-wrap">
      <div class="cards-grid" id="cardsGrid"></div>
    </div>
    <div class="no-results" id="noResults" style="display:none;">
      <div class="nr-icon">墨</div>
      <div>未寻得此人</div>
    </div>
  </section>

  <!-- ====== RELATIONS ====== -->
  <section id="relations" class="section">
    <h2 class="sec-title">关系图谱 <span class="sub">师承 · 亲属 · 交游 · 对立</span></h2>
    <p class="sec-desc">儒林中人，以师承举荐相连，以亲属交游相系，亦以恩怨对立相割。点击节点查看人物小传，虚线为对立关系。</p>
    <div class="graph-wrap">
      <div class="graph-toolbar">
        <span class="gt-title">人物关系图谱</span>
        <div class="graph-legend">
          <div class="lg-item"><div class="lg-dot" style="background:#a8281c;"></div>师承/举荐</div>
          <div class="lg-item"><div class="lg-dot" style="background:#8c7a5e;"></div>亲属</div>
          <div class="lg-item"><div class="lg-dot" style="background:#5b7a78;"></div>交游/知己</div>
          <div class="lg-item"><div class="lg-dot" style="background:#4a6fa5;"></div>同僚/同年</div>
          <div class="lg-item"><div class="lg-dash"></div>对立/恩怨</div>
        </div>
      </div>
      <div id="relationMap"></div>
    </div>
  </section>

  <!-- ====== TIMELINE ====== -->
  <section id="timeline" class="section">
    <h2 class="sec-title">情节时间线 <span class="sub">卷轴展开 · 自元末至万历</span></h2>
    <p class="sec-desc">全书故事跨越约二百三十年，涵盖成化、弘治、正德、嘉靖、隆庆、万历六朝。点击人物名可跳转小传。</p>
    <div id="timelineContainer"></div>
  </section>

  <!-- ====== TRAVEL MAP ====== -->
  <section id="travelmap" class="section">
    <h2 class="sec-title">游历地图 <span class="sub">江南水乡 · 儒林足迹</span></h2>
    <p class="sec-desc">故事遍及大江南北，从京城到岭南，从东海之滨到川陕大地。点击右侧人物按钮查看路线，可同时选择多人对比。红色菱形标记为各事件发生地点。</p>
    <div class="travel-wrap">
      <div class="travel-header">
        <h3>人物游历地图</h3>
        <span class="th-hint">点击人物按钮查看路线，可同时选择多人对比</span>
      </div>
      <div class="travel-content">
        <div class="map-svg-container" id="travelMapSvg"></div>
        <div class="route-sidebar">
          <h4>人物游历路线</h4>
          <div id="routeButtons"></div>
          <div class="route-note">
            <strong>地图说明</strong><br>
            《儒林外史》故事遍及大江南北。可同时点选多个人物查看路线，地图上红色菱形标记为各事件发生地点，悬停城市可查看关联人物与事件。
          </div>
        </div>
      </div>
      <div class="map-legend-bar">
        <div class="leg-item"><div class="leg-dot" style="background:#a8281c;"></div>科举迷途</div>
        <div class="leg-item"><div class="leg-dot" style="background:#5b7a78;"></div>高士隐者</div>
        <div class="leg-item"><div class="leg-dot" style="background:#6b4c8a;"></div>名士风流</div>
        <div class="leg-item"><div class="leg-dot" style="background:#4a6fa5;"></div>官僚士绅</div>
        <div class="leg-item"><div class="leg-dot" style="background:#8c7a5e;"></div>市井小人</div>
        <div class="leg-item"><div class="leg-dot" style="background:#2e8b57;"></div>市井奇人</div>
      </div>
    </div>
  </section>

</div>

<!-- ===== MODAL ===== -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal" id="modalContent"></div>
</div>

<footer class="site-footer">
  <span class="foot-mark">
    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M4 4 L4 20 L20 20 L20 4 Z M8 8 L16 8 M8 12 L16 12 M8 16 L13 16" fill="none" stroke="#a8281c" stroke-width="1.5"/></svg>
    功名富贵无凭据 · 费尽心情 · 总把流光误 · © zzht
  </span>
  <span><a href="/">返回首页</a> · <a href="https://github.com/zzht1">GitHub ↗</a></span>
</footer>

<script>
// =====================================================
// DATA — 保留全部原始数据
// =====================================================
const CATEGORIES = {
  'all':      { name: '全部',   icon: '全', color: '#5c5346' },
  'gaoshi':   { name: '高士隐者', icon: '隐', color: '#5b7a78', desc: '洁身自好、不慕功名' },
  'keming':   { name: '科举迷途', icon: '科', color: '#a8281c', desc: '痴迷功名、可悲可叹' },
  'mingshi':  { name: '名士风流', icon: '名', color: '#6b4c8a', desc: '放浪形骸、慷慨豪侠' },
  'liaoguan': { name: '官僚士绅', icon: '官', color: '#4a6fa5', desc: '宦海沉浮、形形色色' },
  'xiaoren':  { name: '市井小人', icon: '俗', color: '#8c7a5e', desc: '趋炎附势、丑态百出' },
  'qiren':     { name: '市井奇人', icon: '奇', color: '#2e8b57', desc: '身怀绝技、不随流俗' }
};

const CHARACTERS = [
  {
    id: 'wangmian',
    name: '王冕',
    alias: '字元章，号煮石山农',
    category: 'gaoshi',
    color: '#5b7a78',
    chapters: '第1回',
    identity: '诸暨农家子弟，自学成才的画家隐士',
    personality: '孤傲清高、孝顺母亲、蔑视权贵、不与世俗同流合污',
    story: '王冕自幼家贫，放牛为生，却天资聪颖，自学画画，终成画荷名家。他为人至孝，有好吃食必先奉母。朝廷权贵慕名求画，他断然拒绝。吴王朱元璋征召，他避走会稽山中，终身不仕。王冕是全书开篇的理想人格，代表了不为功名所动的高洁品格。',
    famousScene: '拒画荷花、避走会稽山',
    quote: '我一介布衣，不求闻达于诸侯，只愿闲云野鹤度此生。',
    relations: [
      { name: '吴王(朱元璋)', type: '对立', desc: '拒绝其征召' },
      { name: '秦老', type: '交游', desc: '少年时的邻居好友' },
      { name: '翟买办', type: '对立', desc: '为权贵索画被拒' }
    ]
  },
  {
    id: 'zhoujin',
    name: '周进',
    alias: '字蒉轩',
    category: 'keming',
    color: '#a8281c',
    chapters: '第2-3回',
    identity: '老童生，后官至国子监司业',
    personality: '痴迷科举、屡试不第而不放弃、迂腐执着、得志后知恩图报',
    story: '周进年过花甲仍是个童生，在薛家集教馆为生，受尽年轻秀才梅玖的嘲弄。后丢了教职，随姐夫金有余去省城做生意。参观贡院时触景生情，伤心欲绝，一头撞在号板上，众人拉都拉不住。几个商人同情他，凑钱替他捐了监生。此后一路中举、中进士，官至国子监司业。他后来在广东学道任上识拔了老童生范进。',
    famousScene: '贡院撞号板 — 触景生情，哭到口吐鲜血',
    quote: '苦读了几十年书，连个秀才也没中过！',
    relations: [
      { name: '范进', type: '师承', desc: '在广东学道任上录取范进' },
