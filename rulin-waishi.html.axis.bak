    category: 'xiaoren',
    color: '#8c7a5e',
    chapters: '第18-20回',
    identity: '衙门中人，包揽词讼',
    personality: '奸诈狡猾、胆大包天、教唆人犯罪',
    story: '潘三爷是杭州衙门里的包揽词讼之人，与匡超人结交后，教他伪造文书、替人代考、包揽官司。后来事情败露，潘三爷被拿问入狱。在狱中他请求匡超人帮忙，匡超人却急忙撇清关系，拒绝相助。潘三爷的故事揭示了科举体制下滋生的腐败与黑幕。',
    famousScene: '教匡超人代考舞弊、入狱后被撇清',
    quote: '',
    relations: [
      { name: '匡超人', type: '交游', desc: '教其犯罪，后被其撇清' }
    ]
  },
  {
    id: 'baotingxi',
    name: '鲍廷玺',
    alias: '',
    category: 'qiren',
    color: '#2e8b57',
    chapters: '第25-27回、第31回',
    identity: '鲍文卿养子，戏班出身',
    personality: '知恩感恩、有情有义、虽卑微却有骨气',
    story: '鲍廷玺原是被鲍文卿收养的孤儿，在戏班中长大。鲍文卿死后，他受到养母（鲍文卿妻子）的排挤和欺侮，被迫离开。后来流落南京，遇到了杜少卿等人，得到帮助。他虽出身戏子，却有情有义，在杜少卿落魄时仍不忘旧情。鲍廷玺的故事串联起了从戏班到名士圈的社会各阶层。',
    famousScene: '被养母赶出家门、在南京得杜少卿相助',
    quote: '',
    relations: [
      { name: '鲍文卿', type: '亲属', desc: '养父，对他恩重如山' },
      { name: '杜少卿', type: '交游', desc: '在南京结识并受其帮助' }
    ]
  }
];

const TIMELINE_EVENTS = [
  { chapter: '第一回', year: '元末明初 · 约1360年代', title: '王冕画荷 · 高洁开篇', chars: ['王冕'], desc: '楔子。农家子弟王冕自学成才，画荷成名，拒绝权贵征召，隐居会稽山。全书以高洁理想开篇。' },
  { chapter: '第二回', year: '成化末年 · 约1487年', title: '周进坐馆 · 受尽嘲弄', chars: ['周进','梅玖'], desc: '花甲老童生周进在薛家集教馆，被年轻秀才梅玖嘲弄羞辱，后丢了教职。' },
  { chapter: '第三回', year: '弘治初年 · 约1490年', title: '周进撞号板 · 范进中举', chars: ['周进','范进','胡屠户'], desc: '周进参观贡院触景生情，撞号板痛哭。商人资助他捐监生，一路中举做官。范进中举喜极而疯。' },
  { chapter: '第五回', year: '弘治年间 · 约1495年', title: '严监生两根灯草', chars: ['严监生','赵氏','严贡生'], desc: '吝啬鬼严监生临死伸出两个指头不咽气，原来嫌灯里多点了一茎灯草费油。' },
  { chapter: '第六回', year: '弘治年间 · 约1496年', title: '严贡生横行霸道', chars: ['严贡生','赵氏'], desc: '严贡生强占邻居家猪、赖船钱，弟弟死后欺压弟媳赵氏，强夺家产。' },
  { chapter: '第八至十一回', year: '正德末年 · 约1519年', title: '娄公子西湖闹剧', chars: ['娄中堂二公子','杨执中','权勿用','蘧公孙'], desc: '娄府二位公子附庸风雅，三顾茅庐请"高人"杨执中，结交伪名士权勿用，西湖诗会大闹笑话。此年正值宁王朱宸濠叛乱。' },
  { chapter: '第十三至十四回', year: '嘉靖前期 · 约1525年', title: '马二先生游西湖', chars: ['马二先生','蘧公孙'], desc: '选家马二先生游览西湖，不看山水只看文章，迂腐可笑却又为人善良。' },
  { chapter: '第十五至二十回', year: '嘉靖年间 · 约1528年', title: '匡超人堕落之路', chars: ['匡超人','马二先生','潘三爷','牛布衣'], desc: '从孝顺的拆字少年到结交恶友、代考舞弊、弃妻进京，匡超人一步步堕落为衣冠禽兽。牛布衣客死芜湖关。' },
  { chapter: '第二十一至二十四回', year: '嘉靖九年 · 1530年', title: '牛浦郎冒名行骗', chars: ['牛浦郎','牛布衣'], desc: '杂货店少年牛浦郎捡到牛布衣遗稿，冒名顶替四处招摇撞骗，丑态百出。' },
  { chapter: '第二十四至二十六回', year: '嘉靖十六年 · 1537年', title: '鲍文卿义薄云天', chars: ['鲍文卿','鲍廷玺','向鼎'], desc: '戏子鲍文卿知恩图报救助向知县，收养孤儿鲍廷玺。虽为戏子却有士人风骨。' },
  { chapter: '第三十一至三十四回', year: '嘉靖中期 · 约1552年', title: '杜少卿豪侠风流', chars: ['杜少卿','迟衡山','庄绍光'], desc: '天长杜府公子杜少卿挥金如土，携妻游清凉山，装病辞博学鸿词科，展现真名士风度。' },
  { chapter: '第三十六至三十七回', year: '嘉靖三十五年 · 1556年', title: '泰伯祠大祭', chars: ['虞博士','迟衡山','杜少卿','庄绍光'], desc: '全书高潮。迟衡山倡议、杜少卿等人支持、虞博士主祭，以古礼祭祀泰伯，寄托真儒理想。' },
  { chapter: '第三十八至四十回', year: '嘉靖后期 · 约1565年', title: '郭孝子万里寻父', chars: ['郭孝子'], desc: '郭孝子跋涉二十年，走遍川陕寻找隐姓埋名的父亲（因宁王之乱逃亡），最终负骨还乡。至孝感天动地。' },
  { chapter: '第五十五回', year: '万历二十三年 · 1595年', title: '四大奇人 · 收束全书', chars: [], desc: '季遐年（写字）、王太（下棋）、盖宽（画画）、荆元（弹琴），四位市井奇人身怀绝技却不慕功名。全书以"市井中有四大奇人"收束，寄寓深意。' }
];

// =====================================================
// INIT
// =====================================================
document.addEventListener('DOMContentLoaded', () => {
  initStats();
  initOverview();
  initNavTabs();
  initFilters();
  renderCards();
  initTimeline();
  initRelationMap();
  initMap();
  initSearch();
});

function initStats() {
  document.getElementById('totalChars').textContent = CHARACTERS.length;
  const cats = new Set(CHARACTERS.map(c => c.category));
  document.getElementById('totalCats').textContent = Object.keys(CATEGORIES).length - 1;
  document.getElementById('totalEvents').textContent = TIMELINE_EVENTS.length;
}

// ===== Navigation =====
function initNavTabs() {
  document.querySelectorAll('.nav-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById(tab.dataset.section).classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
}

// ===== Overview =====
function initOverview() {
  const container = document.getElementById('categoryCards');
  Object.entries(CATEGORIES).forEach(([key, cat]) => {
    if (key === 'all') return;
    const count = CHARACTERS.filter(c => c.category === key).length;
    const card = document.createElement('div');
    card.className = 'cat-card';
    card.style.setProperty('--gc', cat.color);
    card.innerHTML = `
      <div class="cat-head">
        <div class="cat-icon">${cat.icon}</div>
        <div>
          <div class="cat-name">${cat.name}</div>
          <div class="cat-count">${count} 人</div>
        </div>
      </div>
      <div class="cat-desc">${cat.desc}</div>
    `;
    card.addEventListener('click', () => {
      document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
      document.querySelector('[data-section="characters"]').classList.add('active');
      document.getElementById('characters').classList.add('active');
      setActiveFilter(key);
    });
    container.appendChild(card);
  });
}

// ===== Filters =====
let activeFilter = 'all';
function initFilters() {
  const container = document.getElementById('filterChips');
  Object.entries(CATEGORIES).forEach(([key, cat]) => {
    const chip = document.createElement('button');
    chip.className = 'chip' + (key === 'all' ? ' active' : '');
    chip.textContent = cat.icon + ' ' + cat.name;
    chip.dataset.cat = key;
    chip.addEventListener('click', () => setActiveFilter(key));
    container.appendChild(chip);
  });
}
function setActiveFilter(key) {
  activeFilter = key;
  document.querySelectorAll('.chip').forEach(c => c.classList.toggle('active', c.dataset.cat === key));
  renderCards();
}

// ===== Search =====
function initSearch() {
  const input = document.getElementById('searchInput');
  input.addEventListener('input', () => renderCards());
}

// ===== Cards =====
function renderCards() {
  const query = document.getElementById('searchInput').value.trim().toLowerCase();
  const grid = document.getElementById('cardsGrid');
  const noResults = document.getElementById('noResults');
  grid.innerHTML = '';

  let filtered = CHARACTERS.filter(c => {
    if (activeFilter !== 'all' && c.category !== activeFilter) return false;
    if (query) {
      const text = (c.name + c.alias + c.identity + c.personality + c.story).toLowerCase();
      return text.includes(query);
    }
    return true;
  });

  if (filtered.length === 0) {
    noResults.style.display = 'block';
    return;
  }
  noResults.style.display = 'none';

  filtered.forEach(char => {
    const cat = CATEGORIES[char.category];
    const card = document.createElement('div');
    card.className = 'char-card';
    card.style.setProperty('--gc', char.color);
    card.innerHTML = `
      <div class="c-head">
        <div>
          <div class="c-name-stamped">${char.name}</div>
          ${char.alias ? `<div class="c-alias">${char.alias}</div>` : ''}
        </div>
      </div>
      <div class="c-tags">
        <span class="c-tag c-tag-cat">${cat.icon} ${cat.name}</span>
        <span class="c-tag c-tag-chap">${char.chapters}</span>
      </div>
      <div class="c-desc">${char.story.substring(0, 100)}...</div>
      <div class="c-foot">
        <span>${char.identity.substring(0, 16)}${char.identity.length > 16 ? '...' : ''}</span>
        <span class="c-scene">${char.famousScene ? char.famousScene.substring(0, 12) : ''}</span>
      </div>
    `;
    card.addEventListener('click', () => showModal(char));
    grid.appendChild(card);
  });
}

// ===== Modal =====
function showModal(char) {
  const cat = CATEGORIES[char.category];
  const overlay = document.getElementById('modalOverlay');
  const modal = document.getElementById('modalContent');

  modal.style.setProperty('--gc', char.color);

  let relationsHTML = '';
  if (char.relations && char.relations.length > 0) {
    relationsHTML = `
      <div class="modal-section">
        <h3>人物关系</h3>
        <div class="relation-list">
          ${char.relations.map(r => {
            const rchar = CHARACTERS.find(c => c.name === r.name || c.alias.includes(r.name));
            return `<span class="relation-tag" data-charid="${rchar ? rchar.id : ''}" title="${r.desc}">
              ${r.name}
              <small>${r.type}</small>
            </span>`;
          }).join('')}
        </div>
      </div>
    `;
  }

  let quoteHTML = '';
  if (char.quote) {
    quoteHTML = `
      <div class="modal-section">
        <h3>经典语录</h3>
        <div class="quote-block">${char.quote}</div>
      </div>
    `;
  }

  modal.innerHTML = `
    <button class="modal-close" onclick="closeModal()">×</button>
    <div class="modal-banner">
      <h2><span class="c-name-stamped" style="font-size:1.7rem;">${char.name}</span> <span class="mb-seal">${cat.icon}</span></h2>
      <div class="mb-sub">${char.alias || char.identity}</div>
      <div class="mb-tags">
        <span class="c-tag c-tag-cat" style="color:${char.color}; background:${char.color}15; border-color:${char.color}33;">${cat.icon} ${cat.name}</span>
        <span class="c-tag c-tag-chap">${char.chapters}</span>
      </div>
    </div>
    <div class="modal-body">
      <div class="modal-section">
        <div class="info-grid">
          <div class="info-item">
            <div class="info-label">身份</div>
            <div class="info-value">${char.identity}</div>
          </div>
          <div class="info-item">
            <div class="info-label">出场回目</div>
            <div class="info-value">${char.chapters}</div>
          </div>
          <div class="info-item">
            <div class="info-label">人物类型</div>
            <div class="info-value">${cat.icon} ${cat.name}</div>
          </div>
          <div class="info-item">
            <div class="info-label">经典情节</div>
            <div class="info-value">${char.famousScene || '—'}</div>
          </div>
        </div>
      </div>
      <div class="modal-section">
        <h3>性格特征</h3>
        <p>${char.personality}</p>
      </div>
      <div class="modal-section">
        <h3>人物故事</h3>
        <p>${char.story}</p>
      </div>
      ${quoteHTML}
      ${relationsHTML}
    </div>
  `;

  overlay.classList.add('show');
  document.body.style.overflow = 'hidden';

  // Bind relation tag clicks
  modal.querySelectorAll('.relation-tag').forEach(tag => {
    tag.addEventListener('click', () => {
      const id = tag.dataset.charid;
      if (id) {
        const rchar = CHARACTERS.find(c => c.id === id);
        if (rchar) showModal(rchar);
      }
    });
  });
}

function closeModal() {
  document.getElementById('modalOverlay').classList.remove('show');
  document.body.style.overflow = '';
}

document.getElementById('modalOverlay').addEventListener('click', e => {
  if (e.target === e.currentTarget) closeModal();
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

// ===== Timeline =====
function initTimeline() {
  const container = document.getElementById('timelineContainer');

  const eraDiv = document.createElement('div');
  eraDiv.className = 'tl-era';
  eraDiv.innerHTML = '元末明初 至 万历年间<small>全书故事跨越约二百三十年（约1360—1595），涵盖成化、弘治、正德、嘉靖、隆庆、万历六朝</small>';
  container.appendChild(eraDiv);

  TIMELINE_EVENTS.forEach((evt, idx) => {
    const item = document.createElement('div');
    item.className = 'tl-item';
    item.innerHTML = `
      <div class="tl-dot"></div>
      <div class="tl-year">${evt.year || ''}</div>
      <div class="tl-chapter">${evt.chapter}</div>
      <div class="tl-title">${evt.title}</div>
      <div class="tl-chars">
        ${evt.chars.map(name => {
          const ch = CHARACTERS.find(c => c.name === name);
          return `<span class="tl-char-tag" data-charid="${ch ? ch.id : ''}">${name}</span>`;
        }).join('')}
      </div>
      <div class="tl-desc">${evt.desc}</div>
    `;
    item.querySelectorAll('.tl-char-tag').forEach(tag => {
      tag.addEventListener('click', e => {
        e.stopPropagation();
        const ch = CHARACTERS.find(c => c.id === tag.dataset.charid);
        if (ch) showModal(ch);
      });
    });
    container.appendChild(item);
  });
}

// ===== Relation Map =====
function initRelationMap() {
  const container = document.getElementById('relationMap');

  // Define nodes with positions
  const nodes = [
    { id: 'wangmian', x: 100, y: 80, name: '王冕', color: '#5b7a78', group: 'gaoshi' },
    { id: 'zhoujin', x: 300, y: 60, name: '周进', color: '#a8281c', group: 'keming' },
    { id: 'fanjin', x: 450, y: 60, name: '范进', color: '#a8281c', group: 'keming' },
    { id: 'hutuohu', x: 540, y: 130, name: '胡屠户', color: '#8c7a5e', group: 'xiaoren' },
    { id: 'yanjiansheng', x: 300, y: 200, name: '严监生', color: '#8c7a5e', group: 'xiaoren' },
    { id: 'yangongsheng', x: 440, y: 200, name: '严贡生', color: '#8c7a5e', group: 'xiaoren' },
    { id: 'louer', x: 600, y: 200, name: '娄公子', color: '#4a6fa5', group: 'liaoguan' },
    { id: 'qugongzi', x: 730, y: 140, name: '蘧公孙', color: '#4a6fa5', group: 'liaoguan' },
    { id: 'maer', x: 170, y: 330, name: '马二先生', color: '#8c7a5e', group: 'xiaoren' },
    { id: 'kuangchaoren', x: 340, y: 340, name: '匡超人', color: '#a8281c', group: 'keming' },
    { id: 'panSan', x: 470, y: 380, name: '潘三爷', color: '#8c7a5e', group: 'xiaoren' },
    { id: 'niubuyi', x: 600, y: 340, name: '牛布衣', color: '#6b4c8a', group: 'mingshi' },
    { id: 'niupulang', x: 730, y: 380, name: '牛浦郎', color: '#8c7a5e', group: 'xiaoren' },
    { id: 'gongshenglu', x: 170, y: 460, name: '鲍文卿', color: '#2e8b57', group: 'qiren' },
    { id: 'baotingxi', x: 340, y: 490, name: '鲍廷玺', color: '#2e8b57', group: 'qiren' },
    { id: 'dushaoqing', x: 500, y: 500, name: '杜少卿', color: '#6b4c8a', group: 'mingshi' },
    { id: 'chihs', x: 660, y: 490, name: '迟衡山', color: '#6b4c8a', group: 'mingshi' },
    { id: 'zhuangshaoguang', x: 780, y: 540, name: '庄绍光', color: '#5b7a78', group: 'gaoshi' },
    { id: 'yuboshi', x: 660, y: 600, name: '虞博士', color: '#5b7a78', group: 'gaoshi' },
    { id: 'guxiaozi', x: 340, y: 600, name: '郭孝子', color: '#5b7a78', group: 'gaoshi' },
  ];

  const edges = [
    { from: 'zhoujin', to: 'fanjin', type: '师承', color: '#a8281c' },
    { from: 'fanjin', to: 'hutuohu', type: '亲属', color: '#8c7a5e' },
    { from: 'yanjiansheng', to: 'yangongsheng', type: '亲属', color: '#8c7a5e' },
    { from: 'louer', to: 'qugongzi', type: '交游', color: '#5b7a78' },
    { from: 'maer', to: 'kuangchaoren', type: '师承', color: '#a8281c' },
    { from: 'kuangchaoren', to: 'panSan', type: '交游', color: '#5c5346', dash: true },
    { from: 'niubuyi', to: 'niupulang', type: '对立', color: '#5c5346', dash: true },
    { from: 'gongshenglu', to: 'baotingxi', type: '亲属', color: '#8c7a5e' },
    { from: 'baotingxi', to: 'dushaoqing', type: '交游', color: '#5b7a78' },
    { from: 'dushaoqing', to: 'chihs', type: '交游', color: '#5b7a78' },
    { from: 'chihs', to: 'zhuangshaoguang', type: '交游', color: '#5b7a78' },
    { from: 'chihs', to: 'yuboshi', type: '交游', color: '#5b7a78' },
    { from: 'dushaoqing', to: 'zhuangshaoguang', type: '交游', color: '#5b7a78' },
    { from: 'dushaoqing', to: 'yuboshi', type: '同僚', color: '#4a6fa5' },
    { from: 'dushaoqing', to: 'guxiaozi', type: '交游', color: '#5b7a78' },
    { from: 'qugongzi', to: 'maer', type: '交游', color: '#5b7a78' },
    { from: 'fanjin', to: 'niubuyi', type: '交游', color: '#5b7a78' },
  ];

  const svgW = 900, svgH = 680;
  let svg = `<svg viewBox="0 0 ${svgW} ${svgH}" width="100%" xmlns="http://www.w3.org/2000/svg" style="font-family:'Noto Sans SC',sans-serif;">`;

  // Draw edges
  edges.forEach(e => {
    const n1 = nodes.find(n => n.id === e.from);
    const n2 = nodes.find(n => n.id === e.to);
    if (!n1 || !n2) return;
    const dashAttr = e.dash ? 'stroke-dasharray="6,4"' : '';
    svg += `<line x1="${n1.x}" y1="${n1.y}" x2="${n2.x}" y2="${n2.y}" stroke="${e.color}" stroke-width="1.5" stroke-opacity="0.4" ${dashAttr}/>`;
    const mx = (n1.x + n2.x) / 2, my = (n1.y + n2.y) / 2;
    svg += `<text x="${mx}" y="${my - 4}" text-anchor="middle" font-size="9" fill="${e.color}" opacity="0.65" font-family="'Noto Serif SC',serif">${e.type}</text>`;
  });

  // Draw nodes
  nodes.forEach(n => {
    svg += `<g class="map-node" data-id="${n.id}" style="cursor:pointer;">`;
    svg += `<circle class="node-halo" cx="${n.x}" cy="${n.y}" r="26" fill="${n.color}" opacity="0.12" stroke="${n.color}" stroke-width="2"/>`;
    svg += `<circle cx="${n.x}" cy="${n.y}" r="18" fill="${n.color}"/>`;
    svg += `<text x="${n.x}" y="${n.y + 5}" text-anchor="middle" font-size="11" fill="#fbf5e2" font-weight="700" font-family="'Noto Serif SC',serif" pointer-events="none">${n.name.charAt(0)}</text>`;
    svg += `<text x="${n.x}" y="${n.y + 44}" text-anchor="middle" font-size="11" fill="#2b2620" font-weight="500" font-family="'Noto Serif SC',serif" pointer-events="none">${n.name}</text>`;
    svg += `</g>`;
  });

  svg += '</svg>';
  container.innerHTML = svg;

  // Bind clicks
  container.querySelectorAll('.map-node').forEach(node => {
    node.addEventListener('click', () => {
      const char = CHARACTERS.find(c => c.id === node.dataset.id);
      if (char) showModal(char);
    });
  });
}

// ===== Travel Route Map =====
function initMap() {
  const cities = {
    beijing:   { name: '京师',   x: 590, y: 155, region: '直隶' },
    jinan:     { name: '济南',   x: 585, y: 245, region: '山东' },
    wenshang:  { name: '汶上',   x: 555, y: 268, region: '山东' },
    gaoYao:    { name: '高要',   x: 500, y: 618, region: '广东' },
    guangzhou: { name: '广州',   x: 530, y: 640, region: '广东' },
    zhuji:     { name: '诸暨',   x: 640, y: 400, region: '浙江' },
    kuaiji:    { name: '会稽山', x: 660, y: 420, region: '浙江' },
    hangzhou:  { name: '杭州',   x: 635, y: 382, region: '浙江' },
    huzhou:    { name: '湖州',   x: 615, y: 368, region: '浙江' },
    jiaxing:   { name: '嘉兴',   x: 648, y: 372, region: '浙江' },
    chuzhou_z: { name: '处州',   x: 625, y: 418, region: '浙江' },
    wuhu:      { name: '芜湖',   x: 580, y: 395, region: '安徽' },
    nanjing:   { name: '南京',   x: 590, y: 350, region: '江南' },
    tianchang: { name: '天长',   x: 580, y: 330, region: '安徽' },
    yueqing:   { name: '乐清',   x: 655, y: 445, region: '浙江' },
    xian:      { name: '西安',   x: 370, y: 275, region: '陕西' },
    chengdu:   { name: '成都',   x: 275, y: 425, region: '四川' },
    nanchang:  { name: '南昌',   x: 545, y: 450, region: '江西' },
    taizhou:   { name: '泰州',   x: 612, y: 342, region: '江苏' },
    xuzhou:    { name: '徐州',   x: 555, y: 302, region: '江苏' },
    luoyang:   { name: '洛阳',   x: 460, y: 288, region: '河南' },
    wuchang:   { name: '武昌',   x: 488, y: 418, region: '湖广' },
    fuzhou:    { name: '福州',   x: 628, y: 505, region: '福建' }
  };

  const routes = [
    { id:'wangmian', name:'王冕', color:'#5b7a78', desc:'诸暨→会稽山（隐居）', path:['zhuji','kuaiji'] },
    { id:'zhoujin', name:'周进', color:'#a8281c', desc:'汶上→济南→广东→京师', path:['wenshang','jinan','gaoYao','beijing'] },
    { id:'fanjin', name:'范进', color:'#c4341e', desc:'广东→高要→山东（学道）', path:['guangzhou','gaoYao','jinan'] },
    { id:'kuangchaoren', name:'匡超人', color:'#8c4a1e', desc:'乐清→杭州→京师→杭州', path:['yueqing','hangzhou','beijing','hangzhou'] },
    { id:'dushaoqing', name:'杜少卿', color:'#6b4c8a', desc:'天长→南京（名士风流）', path:['tianchang','nanjing'] },
    { id:'guxiaozi', name:'郭孝子', color:'#2e8b57', desc:'南京→武昌→成都→西安', path:['nanjing','wuchang','chengdu','xian'] },
    { id:'maer', name:'马二先生', color:'#8c7a5e', desc:'处州→杭州（选文游西湖）', path:['chuzhou_z','hangzhou'] },
    { id:'louer', name:'娄公子', color:'#4a6fa5', desc:'湖州→杭州（西湖诗会）', path:['huzhou','hangzhou'] },
    { id:'niubuyi', name:'牛布衣', color:'#7a5a8a', desc:'嘉兴→高要→芜湖（客死）', path:['jiaxing','gaoYao','wuhu'] },
    { id:'baotingxi', name:'鲍廷玺', color:'#3cb371', desc:'南京→天长→南京', path:['nanjing','tianchang','nanjing'] },
    { id:'zhuangshaoguang', name:'庄绍光', color:'#4a8a88', desc:'南京→京师→南京（辞官）', path:['nanjing','beijing','nanjing'] },
    { id:'niupulang', name:'牛浦郎', color:'#a89878', desc:'芜湖→南京（冒名行骗）', path:['wuhu','nanjing'] },
  ];

  const events = [
    { id:'e1',  city:'zhuji',    title:'王冕画荷', chapter:'第1回', dx:-18, dy:-18 },
    { id:'e2',  city:'wenshang', title:'周进撞号板', chapter:'第3回', dx:12, dy:-18 },
    { id:'e3',  city:'gaoYao',   title:'范进中举发疯', chapter:'第3回', dx:-20, dy:-18 },
    { id:'e4',  city:'gaoYao',   title:'严监生两根灯草', chapter:'第5回', dx:-20, dy:14 },
    { id:'e5',  city:'gaoYao',   title:'严贡生横行', chapter:'第6回', dx:-20, dy:32 },
    { id:'e6',  city:'hangzhou', title:'娄公子西湖诗会', chapter:'第8回', dx:12, dy:-18 },
    { id:'e7',  city:'hangzhou', title:'马二先生游西湖', chapter:'第13回', dx:12, dy:0 },
    { id:'e8',  city:'hangzhou', title:'匡超人代考舞弊', chapter:'第19回', dx:12, dy:18 },
    { id:'e9',  city:'wuhu',     title:'牛布衣客死', chapter:'第20回', dx:-18, dy:-18 },
    { id:'e10', city:'wuhu',     title:'牛浦郎冒名', chapter:'第21回', dx:-18, dy:14 },
    { id:'e11', city:'nanjing',  title:'鲍文卿义举', chapter:'第25回', dx:12, dy:-18 },
    { id:'e12', city:'nanjing',  title:'杜少卿携妻游山', chapter:'第33回', dx:12, dy:0 },
    { id:'e13', city:'nanjing',  title:'泰伯祠大祭', chapter:'第37回', dx:12, dy:18 },
    { id:'e14', city:'chengdu',  title:'郭孝子寻父', chapter:'第38回', dx:12, dy:-16 },
  ];

  const container = document.getElementById('travelMapSvg');
  const btnContainer = document.getElementById('routeButtons');
  const activeRoutes = new Set();

  routes.forEach(route => {
    const btn = document.createElement('button');
    btn.className = 'route-btn';
    btn.dataset.routeId = route.id;
    btn.innerHTML = `
      <div class="route-color" style="background:${route.color};"></div>
      <div class="route-info">
        <span class="route-name">${route.name}</span>
        <span class="route-path">${route.desc}</span>
      </div>
    `;
    btn.addEventListener('click', () => toggleRoute(route.id));
    btnContainer.appendChild(btn);
  });

  function toggleRoute(id) {
    if (activeRoutes.has(id)) activeRoutes.delete(id);
    else activeRoutes.add(id);
    btnContainer.querySelectorAll('.route-btn').forEach(b => {
      b.classList.toggle('active', activeRoutes.has(b.dataset.routeId));
    });
    renderMapSVG();
  }

  function getCurve(fromCity, toCity, routeIdx) {
    const mx = (fromCity.x + toCity.x)/2, my = (fromCity.y + toCity.y)/2;
    const dx = toCity.x - fromCity.x, dy = toCity.y - fromCity.y;
    const len = Math.sqrt(dx*dx + dy*dy) || 1;
    const baseOff = Math.min(35, len * 0.18);
    const multiOff = routeIdx * 18;
    const nx = -dy / len, ny = dx / len;
    return { cx: mx + nx*(baseOff+multiOff), cy: my + ny*(baseOff+multiOff) };
  }

  function renderMapSVG() {
    const W = 780, H = 700;
    let svg = `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" style="font-family:'Noto Sans SC',sans-serif;">`;
    svg += `<defs>
      <marker id="arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto"><path d="M0,0 L8,3 L0,6" fill="none" stroke="#a8281c" stroke-width="1.5"/></marker>
    </defs>`;
    /* 米色底图 */
    svg += `<rect width="${W}" height="${H}" fill="#f0e4c8" rx="8"/>`;
    /* 淡青网格 */
    for (let i=100;i<W;i+=100) svg+=`<line x1="${i}" y1="0" x2="${i}" y2="${H}" stroke="#5b7a78" stroke-width="0.3" opacity="0.1"/>`;
    for (let i=100;i<H;i+=100) svg+=`<line x1="0" y1="${i}" x2="${W}" y2="${i}" stroke="#5b7a78" stroke-width="0.3" opacity="0.1"/>`;

    // China outline — 江南淡青色调
    svg += `<path d="M600,65 C635,55 680,55 720,85 C745,105 755,125 748,145 C740,158 725,152 705,148 C685,145 665,150 652,158 C645,165 650,178 665,188 C680,198 695,195 710,210 C718,218 715,230 708,242 C700,258 695,275 690,295 C685,315 680,330 675,345 C668,358 662,370 658,382 C652,395 658,408 660,415 C658,425 655,435 658,448 C660,462 655,478 648,495 C640,510 630,525 618,540 C605,555 590,568 575,580 C560,592 545,605 530,620 C515,638 498,652 480,662 C460,672 440,670 418,660 C395,648 370,638 345,628 C320,618 295,600 272,578 C250,555 235,528 222,498 C210,468 198,438 188,405 C178,372 168,338 160,305 C152,272 148,240 150,210 C155,178 165,152 182,130 C200,108 225,92 255,80 C290,68 328,60 370,55 C415,50 460,50 505,52 C545,55 575,58 600,65 Z" fill="#e8dfc8" stroke="#8c7a5e" stroke-width="1.5" stroke-linejoin="round" opacity="0.7"/>`;

    // Rivers — 淡青蓝
    svg += `<path d="M220,430 Q320,415 400,420 Q470,418 530,405 Q570,395 600,385 Q630,380 658,382" fill="none" stroke="#7ba8b8" stroke-width="2" stroke-dasharray="8,4" opacity="0.45"/>`;
    svg += `<text x="420" y="408" font-size="10" fill="#5b7a78" opacity="0.5" font-style="italic" font-family="'Noto Serif SC',serif">长 江</text>`;
    svg += `<path d="M200,260 Q300,230 380,250 Q450,265 500,260 Q550,255 585,248 Q620,230 660,188" fill="none" stroke="#a89878" stroke-width="1.5" stroke-dasharray="6,4" opacity="0.35"/>`;
    svg += `<text x="430" y="248" font-size="9" fill="#8c7a5e" opacity="0.45" font-style="italic" font-family="'Noto Serif SC',serif">黄 河</text>`;

    // Province labels
    [{n:'直隶',x:585,y:118},{n:'山东',x:612,y:255},{n:'江苏',x:622,y:318},{n:'浙江',x:668,y:415},{n:'江西',x:535,y:478},{n:'安徽',x:555,y:388},{n:'河南',x:458,y:278},{n:'陕西',x:358,y:258},{n:'四川',x:265,y:448},{n:'湖广',x:468,y:448},{n:'广东',x:505,y:600},{n:'福建',x:638,y:525}].forEach(p => {
      svg += `<text x="${p.x}" y="${p.y}" font-size="12" fill="#8c7a5e" font-family="'Noto Serif SC',serif" opacity="0.4" text-anchor="middle">${p.n}</text>`;
    });

    // ====== ACTIVE ROUTES ======
    const activeArr = [...activeRoutes];
    activeArr.forEach((routeId, routeIdx) => {
      const route = routes.find(r => r.id === routeId);
      if (!route) return;
      for (let i = 0; i < route.path.length - 1; i++) {
        const from = cities[route.path[i]];
        let toIdx = i + 1;
        if (route.path[toIdx] === route.path[i] && toIdx+1 < route.path.length) toIdx++;
        const to = cities[route.path[toIdx]];
        if (!from || !to) continue;
        const {cx, cy} = getCurve(from, to, routeIdx % 4);
        svg += `<path d="M${from.x},${from.y} Q${cx},${cy} ${to.x},${to.y}" stroke="${route.color}" stroke-width="10" fill="none" opacity="0.08" stroke-linecap="round"/>`;
        svg += `<path d="M${from.x},${from.y} Q${cx},${cy} ${to.x},${to.y}" stroke="${route.color}" stroke-width="3" fill="none" stroke-dasharray="10,6" stroke-linecap="round" marker-end="url(#arrow)" style="animation:routeDashFlow 0.8s linear infinite;"/>`;
        svg += `<circle cx="${cx}" cy="${cy}" r="10" fill="${route.color}"/>`;
        svg += `<text x="${cx}" y="${cy+4}" text-anchor="middle" font-size="10" fill="#fbf5e2" font-weight="700" font-family="'Noto Serif SC',serif">${i+1}</text>`;
      }
    });

    // ====== EVENT MARKERS ======
    events.forEach(evt => {
      const city = cities[evt.city];
      if (!city) return;
      const ex = city.x + evt.dx, ey = city.y + evt.dy;
      svg += `<g style="cursor:pointer;">`;
      svg += `<title>${evt.chapter}：${evt.title}</title>`;
      svg += `<rect x="${ex-3}" y="${ey-3}" width="6" height="6" rx="1" fill="#a8281c" transform="rotate(45,${ex},${ey})" stroke="#fbf5e2" stroke-width="1"/>`;
      svg += `<text x="${ex+8}" y="${ey+3}" font-size="8.5" fill="#a8281c" font-weight="500" font-family="'Noto Serif SC',serif">${evt.title}</text>`;
      svg += `</g>`;
    });

    // ====== CITY MARKERS ======
    const labelOffsets = {
      beijing:{x:10,y:-6,a:'start'},jinan:{x:10,y:5,a:'start'},wenshang:{x:-10,y:-6,a:'end'},
      gaoYao:{x:-10,y:5,a:'end'},guangzhou:{x:10,y:5,a:'start'},zhuji:{x:10,y:-4,a:'start'},
      kuaiji:{x:10,y:5,a:'start'},hangzhou:{x:10,y:-4,a:'start'},huzhou:{x:-10,y:-4,a:'end'},
      jiaxing:{x:10,y:4,a:'start'},chuzhou_z:{x:10,y:5,a:'start'},wuhu:{x:-10,y:-6,a:'end'},
      nanjing:{x:-10,y:-6,a:'end'},tianchang:{x:-10,y:-4,a:'end'},yueqing:{x:10,y:5,a:'start'},
      xian:{x:10,y:5,a:'start'},chengdu:{x:-10,y:5,a:'end'},nanchang:{x:10,y:5,a:'start'},
      taizhou:{x:10,y:-4,a:'start'},xuzhou:{x:-10,y:4,a:'end'},luoyang:{x:10,y:5,a:'start'},
      wuchang:{x:10,y:5,a:'start'},fuzhou:{x:10,y:5,a:'start'}
    };

    Object.entries(cities).forEach(([id, city]) => {
      const onRoutes = activeArr.filter(rid => routes.find(r=>r.id===rid)?.path.includes(id));
      const isActive = onRoutes.length > 0;
      const r = isActive ? 7 : 4.5;
      const sw = isActive ? 2.5 : 1.5;
      const fc = isActive ? (routes.find(r=>r.id===onRoutes[0])?.color||'#2b2620') : '#2b2620';
      const charsHere = routes.filter(r=>r.path.includes(id)).map(r=>r.name);
      const evtsHere = events.filter(e=>e.city===id).map(e=>e.title);
      let tip = `${city.name}（${city.region}）`;
      if(charsHere.length) tip += `\n途经人物：${[...new Set(charsHere)].join('、')}`;
      if(evtsHere.length) tip += `\n事件：${evtsHere.join('、')}`;

      svg += `<g style="cursor:pointer;"><title>${tip}</title>`;
      if(isActive) svg += `<circle cx="${city.x}" cy="${city.y}" r="${r+4}" fill="${fc}" opacity="0.12"/>`;
      svg += `<circle cx="${city.x}" cy="${city.y}" r="${r}" fill="${fc}" stroke="#fbf5e2" stroke-width="${sw}"/>`;
      const lo = labelOffsets[id] || {x:10,y:4,a:'start'};
      svg += `<text x="${city.x+lo.x}" y="${city.y+lo.y}" text-anchor="${lo.a}" font-size="${isActive?12:10.5}" fill="${isActive?fc:'#2b2620'}" font-weight="${isActive?700:400}" font-family="'Noto Serif SC',serif">${city.name}</text>`;
      svg += `</g>`;
    });

    // Compass + Scale
    svg += `<g transform="translate(720,620)"><circle cx="0" cy="0" r="22" fill="#f0e4c8" stroke="#8c7a5e" stroke-width="1"/><text x="0" y="-8" text-anchor="middle" font-size="11" fill="#8c7a5e" font-weight="600">N</text><path d="M0,-5 L3,8 L0,5 L-3,8 Z" fill="#8c7a5e"/></g>`;
    svg += `<g transform="translate(60,650)"><line x1="0" y1="0" x2="80" y2="0" stroke="#8c7a5e" stroke-width="1.5"/><line x1="0" y1="-4" x2="0" y2="4" stroke="#8c7a5e" stroke-width="1.5"/><line x1="80" y1="-4" x2="80" y2="4" stroke="#8c7a5e" stroke-width="1.5"/><text x="40" y="14" text-anchor="middle" font-size="9" fill="#8c7a5e">≈ 500里</text></g>`;

    svg += '</svg>';
    container.innerHTML = svg;
  }

  renderMapSVG();
}
</script>
</body>
</html>
